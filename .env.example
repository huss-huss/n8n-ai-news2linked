# Copy to .env and fill in real values. Never commit .env.
# API keys and OAuth secrets are stored as n8n credentials (Credentials -> Add credential),
# not here. This file only holds runtime settings.

# --- n8n runtime ---
# Generate with: openssl rand -hex 32. Keep it stable or stored credentials become unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
GENERIC_TIMEZONE=UTC
# The workflows read the settings below via $env, which n8n 2.x blocks by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Publishing safety ---
# true (default): format posts and log them, publish nothing. Set to false to post to LinkedIn.
DRY_RUN=true
# Posts published per run (the schedule runs once a day)
MAX_POSTS_PER_RUN=1
LINKEDIN_CHAR_LIMIT=3000

# --- Article selection ---
MIN_ARTICLE_AGE_HOURS=1
MAX_ARTICLE_AGE_HOURS=48

# --- LLM ---
OPENAI_MODEL=gpt-4o-mini

# --- Failure alerts (optional) ---
# Slack- or Discord-style incoming webhook URL. Leave empty to disable alerts.
ALERT_WEBHOOK_URL=
